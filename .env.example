# ── Dev mode ──────────────────────────────────────────────────────────────────
# Set ORCID_CLIENT_ID=dev to bypass OAuth entirely (no credentials needed).
# A mock user "Dev User (local)" is injected automatically.
# Switch to real ORCID credentials when deploying.
ORCID_CLIENT_ID=dev
ORCID_CLIENT_SECRET=dev

# ── ORCID OAuth (production / sandbox) ───────────────────────────────────────
# Register at https://sandbox.orcid.org/developer-tools (dev)
#             https://orcid.org/developer-tools (production)
# Redirect URI: http://localhost:8000/auth/callback
# ORCID_CLIENT_ID=APP-XXXXXXXXXXXX
# ORCID_CLIENT_SECRET=your-client-secret
# ORCID_SANDBOX=true   # set false for production ORCID

# Random secret for session signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Base URL for OAuth redirect (no trailing slash)
BASE_URL=http://localhost:8000

# Path to SQLite database
DB_PATH=data/annotations.db
